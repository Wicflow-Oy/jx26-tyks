# Server: copy to /opt/jx/tyks/.env and chmod 600. Local development: put the same variables in .env.local (gitignored).
# Every variable is named; none is filled in. Empty means "use the default".

# This app's own Claude key (never in chat, git or logs). Optional: without it the app uses fixed template wording and
# makes no model calls.
ANTHROPIC_API_KEY=
# Default claude-haiku-5-5
AEI_MODEL=
# replay (default, precomputed) | template | anthropic (live calls, guarded by the cap and rate limits below)
AEI_NARRATOR=
# Daily live-model spend cap in USD (default 20)
AEI_DAILY_SPEND_USD=
# API requests per IP per minute (default 120)
AEI_RATE_LIMIT_PER_MIN=
# Live model calls per IP per minute / per day (defaults 6 / 60)
AEI_LLM_RATE_LIMIT_PER_MIN=
AEI_LLM_RATE_LIMIT_PER_DAY=
# Optional EU route for live calls: anthropic (default) | bedrock | vertex
AEI_LLM_BACKEND=

# Routing (read by deploy/compose*.yml)
# Hostname (required for Traefik), e.g. strainwatch.example.org, or strainwatch.<server-ip>.sslip.io without DNS
TYKS_HOST=
# Case A (Traefik): network and cert resolver from the preflight (both required); entrypoint default websecure
TRAEFIK_NETWORK=
TYKS_CERTRESOLVER=
TRAEFIK_ENTRYPOINT=
# Case B (Caddy/nginx): loopback port to publish (default 8765)
TYKS_PORT=
# Where the 6 synthetic CSVs are on the box (default /opt/jx/tyks/data via ../data)
TYKS_DATA_DIR=
# Image tag (default live; "prev" for rollback)
TYKS_TAG=

# Set by the image; leave them out of the server's .env (an empty value here would override the image).
# Outside Docker: AEI_DATA_DIR (the 6 CSVs, default ./data), AEI_CACHE_DIR (default ./.cache), AEI_STATE_DB (SQLite demo
# state, default $AEI_CACHE_DIR/state.sqlite) and AEI_PUBLIC (1 = public-demo defaults: the replay narrator).

# Writes per browser session (default 200)
AEI_MAX_WRITES_PER_SESSION=
# Model prices in USD per million tokens as JSON, e.g. {"claude-haiku-5-5": [0.10, 0.50]} (default: built-in table)
AEI_PRICE_TABLE=
