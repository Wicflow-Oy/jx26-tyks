# Copy to /opt/jx/tyks/.env on the box (chmod 600). Never commit the real file.
# This app's own Claude key (Anthropic Console, its own workspace with a spend limit). Optional: without it the
# demo runs on precomputed/template narration.
ANTHROPIC_API_KEY=
AEI_MODEL=claude-haiku-5-5
# replay = precomputed narration (default, works without a key); anthropic = live calls, guarded by the cap below
AEI_NARRATOR=replay
AEI_DAILY_SPEND_USD=20
AEI_RATE_LIMIT_PER_MIN=120
AEI_LLM_RATE_LIMIT_PER_MIN=6
AEI_LLM_RATE_LIMIT_PER_DAY=60

# Routing (read by deploy/compose.yml)
TYKS_HOST=tyks-demo.demo.wicflow.com
# Without DNS: TYKS_HOST=tyks-demo.<server-ip>.sslip.io
TRAEFIK_NETWORK=n8n_default
TYKS_CERTRESOLVER=zerossl
